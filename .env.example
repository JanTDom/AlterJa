# ==============================================================================
# AlterJa — Konfiguracja środowiskowa (Ściśle chroniona)
# ==============================================================================

# 1. Google Gemini AI (Backend Only - NIGDY w NEXT_PUBLIC_)
GEMINI_API_KEY=

# 2. Supabase Cloud (PostgreSQL, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# 3. Adres kanoniczny aplikacji
NEXT_PUBLIC_APP_URL=https://alterja.pl

# 4. Bezpieczeństwo API i tokeny HMAC
API_AUTH_SECRET=generate-random-32-char-secret-for-api-hmac

# 5. Tryb pracy danych (opcjonalny: production / demo)
ALTERJA_MODE=production
